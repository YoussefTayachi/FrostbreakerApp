  "cards": [
    {
      "dot": "emerald",
      "title": "Der Hauptweg",
      "items": [
        "Ein INSERT in searches loest den Job aus, nicht das Frontend selbst",
        "claim_job() sichert jeden Job mit for update skip locked, haengende holt sie nach 15 Minuten zurueck",
        "get_businesses zieht aus Maps, Hunter, Apollo, Prospeo oder einer CSV und reiht je Firma alle Folgejobs ein"
      ]
    },
    {
      "dot": "cyan",
      "title": "Warum so viele kleine Jobs",
      "items": [
        "300 Website-Abrufe in einem Job scheitern am 217. und wiederholen beim Retry die ganze Suche",
        "Icebreaker und Befundsatz haben eigene Felder und eigene Retrys, damit ein Fehlschlag keinen bezahlten Aufruf mitreisst",
        "Erst alle Pruefungen, dann alle Befundsaetze: sonst trifft jeder Satz seine eigene Pruefung noch laufend an"
      ]
    },
    {
      "dot": "amber",
      "title": "Eine Adressquelle je Weg",
      "items": [
        "maps nimmt die KI-Websuche, corporate nimmt Hunter, apollo und prospeo bringen den Kontakt schon mit",
        "Vorher liefen bei maps beide und bezahlten denselben Kontakt zweimal",
        "Es gibt keine eigene Sende-Engine: Instantly bekommt die Leads und bleibt untaetig, bis ein Mensch startet"
      ]
    }
  ]
