# Backend (Server-seitig, NIE ins Frontend)
SUPABASE_URL=https://bjfksqgbnwzdfygipont.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme
# Fernet-Key zum Verschlüsseln der User-API-Keys (einmalig generieren):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=changeme
# Schuetzt /api/cron/instantly-sync -- muss exakt dem Wert entsprechen, der als
# supabase_vault-Secret 'cron_secret' hinterlegt ist (siehe Migration 0041).
# Ohne diesen Wert in Vercel laeuft der Instantly-Sync nicht.
CRON_SECRET=changeme
# Schuetzt /api/internal/notify-signup -- muss exakt dem Wert entsprechen, der
# als supabase_vault-Secret 'internal_notify_secret' hinterlegt ist (siehe
# Migration 0048).
INTERNAL_NOTIFY_SECRET=changeme
# Slack Incoming-Webhook-URL fuer Founder-Benachrichtigungen (neue Anmeldung,
# neues Abo). Anlegen unter https://api.slack.com/messaging/webhooks. Leer
# lassen, um Benachrichtigungen stillschweigend zu deaktivieren.
SLACK_NOTIFY_WEBHOOK_URL=

# Frontend (public)
NEXT_PUBLIC_SUPABASE_URL=https://bjfksqgbnwzdfygipont.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme

# Stripe Billing (siehe apps/web/lib/billing.ts)
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# Price-IDs aus dem Stripe-Dashboard (Produkt anlegen -> Preis kopieren)
STRIPE_PRICE_STARTER=price_changeme
STRIPE_PRICE_AGENCY=price_changeme

# Worker-Skalierung (app/api/cron/worker-ops, Migration 0110). Ohne die drei
# RAILWAY_*-Werte ueberspringt die Route das Skalieren und wacht nur.
# Token: Railway -> Account Settings -> Tokens. Service- und Environment-ID
# stehen in der URL des Worker-Services im Railway-Dashboard.
RAILWAY_API_TOKEN=
RAILWAY_WORKER_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
# Grenzen fuer lib/worker-scale.ts; leer heisst 6 / 1 / 50.
WORKER_SCALE_MAX=
WORKER_SCALE_IDLE=
WORKER_SCALE_BURST_AT=

# Auf RAILWAY (nicht hier) zu setzen, je Worker-Replik:
#   WORKER_CONCURRENCY  wie viele Jobs eine Replik gleichzeitig bearbeitet
#                       (Voreinstellung 1, gemessen sinnvoll: 4)
#   WORKER_JOB_TYPES    Kommaliste der Jobtypen dieser Replik (leer = alle);
#                       wer Spuren einrichtet, muss alle Typen abdecken
