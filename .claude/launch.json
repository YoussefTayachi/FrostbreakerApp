      "autoPort": true
    },
    {
      "name": "cts-prototype",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../CTS_Prototyp/site",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
